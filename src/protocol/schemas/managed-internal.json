{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pi-relay:managed-internal:1",
  "title": "pi-relay managed internal transport (relay-internal ops, not public wire)",
  "description": "Relay-internal minor-2 operations used between Source and Target processes for managed delivery (packet admission, control propagation, application-ack delivery). These are implementation transport, not part of the approved public managed.json contract; op names are namespaced 'internal.' to keep the two surfaces disjoint.",
  "$defs": {
    "ManagedRoutePacket": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packetVersion": {
          "const": 2
        },
        "bindingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "channelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "event": {
          "$ref": "#/$defs/Event"
        },
        "sourceEventDigest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "fanoutId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "membershipRevision": {
          "type": "integer",
          "minimum": 0
        },
        "routeCreatedAt": {
          "type": "integer",
          "minimum": 0
        },
        "routeValidUntil": {
          "type": "integer",
          "minimum": 0
        },
        "options": {
          "$ref": "#/$defs/ManagedOptions"
        },
        "optionsDigest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "proofKeyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "proof": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "routeRef": {
          "type": "string",
          "minLength": 16,
          "maxLength": 160
        }
      },
      "required": [
        "packetVersion",
        "bindingId",
        "sourceId",
        "channelId",
        "event",
        "sourceEventDigest",
        "fanoutId",
        "membershipRevision",
        "routeCreatedAt",
        "routeValidUntil",
        "options",
        "optionsDigest",
        "proofKeyId",
        "proof",
        "routeRef"
      ]
    },
    "Request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protocol": {
              "const": "pi-relay"
            },
            "major": {
              "const": 1
            },
            "minor": {
              "const": 2
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "op": {
              "const": "internal.target.admit"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "packet": {
                  "$ref": "#/$defs/ManagedRoutePacket"
                },
                "bindingId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "bindingRevision": {
                  "type": "integer",
                  "minimum": 0
                },
                "attachmentId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "required": [
                "packet",
                "bindingId",
                "bindingRevision",
                "attachmentId"
              ]
            }
          },
          "required": [
            "protocol",
            "major",
            "minor",
            "requestId",
            "op",
            "params"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protocol": {
              "const": "pi-relay"
            },
            "major": {
              "const": 1
            },
            "minor": {
              "const": 2
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "op": {
              "const": "internal.target.control"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "event-withdraw",
                    "scope-fence"
                  ]
                },
                "eventId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "scopeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "scopeRevision": {
                  "type": "integer",
                  "minimum": 1
                },
                "controlId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "bindingId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "bindingRevision": {
                  "type": "integer",
                  "minimum": 0
                },
                "attachmentId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "required": [
                "kind",
                "controlId",
                "bindingId",
                "bindingRevision",
                "attachmentId"
              ]
            }
          },
          "required": [
            "protocol",
            "major",
            "minor",
            "requestId",
            "op",
            "params"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protocol": {
              "const": "pi-relay"
            },
            "major": {
              "const": 1
            },
            "minor": {
              "const": 2
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "op": {
              "const": "internal.target.ack"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "responseId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "appliedAt": {
                  "type": "integer",
                  "minimum": 0
                },
                "result": {
                  "$ref": "#/$defs/ApplicationResult"
                },
                "bindingId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "bindingRevision": {
                  "type": "integer",
                  "minimum": 0
                },
                "attachmentId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "required": [
                "responseId",
                "appliedAt",
                "result",
                "bindingId",
                "bindingRevision",
                "attachmentId"
              ]
            }
          },
          "required": [
            "protocol",
            "major",
            "minor",
            "requestId",
            "op",
            "params"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protocol": {
              "const": "pi-relay"
            },
            "major": {
              "const": 1
            },
            "minor": {
              "const": 2
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "op": {
              "const": "internal.source.proof"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bindingId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "eventIds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                }
              },
              "required": [
                "bindingId",
                "eventIds"
              ]
            }
          },
          "required": [
            "protocol",
            "major",
            "minor",
            "requestId",
            "op",
            "params"
          ]
        }
      ]
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "event"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "validUntil": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "kind",
        "id",
        "type",
        "schemaVersion",
        "occurredAt",
        "validUntil",
        "data"
      ]
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision"
      ]
    },
    "ManagedOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audienceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "consumerProfileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "requestedMode": {
          "type": "string",
          "enum": [
            "display",
            "resume"
          ]
        }
      },
      "required": [
        "audienceRef",
        "scope",
        "consumerProfileId",
        "requestedMode"
      ]
    },
    "ApplicationResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "applied",
            "stale",
            "rejected"
          ]
        },
        "applicationRevision": {
          "type": "integer",
          "minimum": 0
        },
        "code": {
          "type": "string",
          "enum": [
            "APPLIED",
            "STALE_EPISODE",
            "OWNER_MISMATCH",
            "ALREADY_CLOSED",
            "INVALID_RESPONSE"
          ]
        }
      },
      "required": [
        "outcome",
        "applicationRevision",
        "code"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "applied"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "const": "APPLIED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "stale"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "STALE_EPISODE",
                  "ALREADY_CLOSED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "rejected"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "OWNER_MISMATCH",
                  "INVALID_RESPONSE"
                ]
              }
            }
          }
        }
      ]
    },
    "ScopeProofEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "publisherId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scopeRevision": {
          "type": "integer",
          "minimum": 1
        },
        "scopeState": {
          "type": "string",
          "enum": [
            "active",
            "paused",
            "closed"
          ]
        },
        "tombstoned": {
          "type": "boolean"
        },
        "audienceState": {
          "type": "string",
          "enum": [
            "open",
            "closed",
            "revoked"
          ]
        }
      },
      "required": [
        "eventId",
        "publisherId",
        "scopeId",
        "scopeRevision",
        "scopeState",
        "tombstoned",
        "audienceState"
      ]
    },
    "ScopeProof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuedAt": {
          "type": "integer",
          "minimum": 0
        },
        "validForMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "proofs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/ScopeProofEntry"
          }
        }
      },
      "required": [
        "issuedAt",
        "validForMs",
        "proofs"
      ]
    }
  }
}